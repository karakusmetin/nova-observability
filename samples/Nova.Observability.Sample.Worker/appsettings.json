{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Nova": {
    "Observability": {
      "Enabled": true,

      "ServiceName": "Nova.Observability.Sample.Worker",

      "ServiceNamespace": "Nova",

      "ServiceVersion": "0.1.0",

      "EnvironmentName": "Development",

      "EnableOtlpExporter": true,

      "EnableConsoleExporter": false,

      "OtlpEndpoint": "http://localhost:4317",

      "OtlpProtocol": "Grpc",

      "TraceSamplingRatio": 1.0,

      "ExporterTimeoutMilliseconds": 5000,

      "ShutdownFlushTimeoutMilliseconds": 3000
    },

    "FileLogging": {
      "Enabled": true,

      "DirectoryPath": "logs",

      "FileNamePrefix": "nova-sample-worker",

      "Format": "Text",

      "UseLocalTime": true,

      "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff",

      "UseShortCategoryName": true,

      "IncludeTraceId": true,

      "TraceIdDisplayLength": 8,

      "HighlightIdentifiers": true,

      "MinimumLevel": "Information",

      "QueueCapacity": 4096,

      "MaxFileSizeMegabytes": 50,

      "RetentionDays": 14,

      "ShutdownTimeoutMilliseconds": 3000
    }
  }
}