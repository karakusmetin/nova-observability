{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Nova": {
    "FileLogging": {
      "Enabled": true,
      "DirectoryPath": "logs",
      "FileNamePrefix": "nova-sample-worker",
      "Format": "Text",

      "UseLocalTime": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff",
      "UseShortCategoryName": true,

      "IncludeTraceId": true,
      "TraceIdDisplayLength": 8,
      "HighlightIdentifiers": true,

      "MinimumLevel": "Information",
      "QueueCapacity": 4096,
      "MaxFileSizeMegabytes": 50,
      "RetentionDays": 14,
      "ShutdownTimeoutMilliseconds": 3000
    }
  }
}