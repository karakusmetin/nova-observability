<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<appSettings>

		<add
		  key="Nova.Observability.Enabled"
		  value="true" />

		<add
		  key="Nova.Observability.ServiceName"
		  value="Nova.Sample.LegacyConsole" />

		<add
		  key="Nova.Observability.ServiceNamespace"
		  value="Nova.Legacy" />

		<add
		  key="Nova.Observability.ServiceVersion"
		  value="0.1.0" />

		<add
		  key="Nova.Observability.Environment"
		  value="Development" />

		<add
		  key="Nova.Observability.EnableOtlpExporter"
		  value="true" />

		<add
		  key="Nova.Observability.EnableConsoleExporter"
		  value="false" />

		<add
		  key="Nova.Observability.OtlpEndpoint"
		  value="http://localhost:4318/" />

		<add
		  key="Nova.Observability.TraceSamplingRatio"
		  value="1.0" />

	</appSettings>

</configuration>