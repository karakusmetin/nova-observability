<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>

		<AssemblyName>Nova.Observability.Hosting</AssemblyName>
		<RootNamespace>Nova.Observability.Hosting</RootNamespace>

		<Description>
			Dependency injection and Generic Host integration for Nova Observability.
		</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference
		  Include="..\Nova.Observability.Abstractions\Nova.Observability.Abstractions.csproj" />

		<ProjectReference
		  Include="..\Nova.Observability.Core\Nova.Observability.Core.csproj" />

		<ProjectReference
		  Include="..\Nova.Observability.OpenTelemetry\Nova.Observability.OpenTelemetry.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference
		  Include="Microsoft.Extensions.Hosting.Abstractions" />

		<PackageReference
		  Include="Microsoft.Extensions.DependencyInjection.Abstractions" />

		<PackageReference
		  Include="Microsoft.Extensions.Logging.Abstractions" />

		<PackageReference
		  Include="OpenTelemetry.Extensions.Hosting" />
	</ItemGroup>

</Project>