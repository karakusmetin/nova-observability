<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>

		<AssemblyName>Nova.Observability.OpenTelemetry</AssemblyName>
		<RootNamespace>Nova.Observability.OpenTelemetry</RootNamespace>

		<Description>
			OpenTelemetry SDK and OTLP exporter integration for Nova Observability.
		</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nova.Observability.Abstractions\Nova.Observability.Abstractions.csproj" />

		<ProjectReference Include="..\Nova.Observability.Core\Nova.Observability.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="OpenTelemetry" />
		
		<PackageReference Include="OpenTelemetry.Exporter.Console" />

		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
	</ItemGroup>

</Project>